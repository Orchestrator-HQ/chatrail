{
  "description": "ChatRail semantic end-of-turn review and session re-entry orientation",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/chatrail/scripts/chatrail.py\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/chatrail/scripts/chatrail.py\" inject",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
